{
  "name": "running-low",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:emu": "vite --mode emulators",
    "build": "tsc -p . && vite build",
    "preview": "vite preview",
    "emulators": "firebase emulators:start --only auth,firestore --project demo-outof",
    "test:rules": "firebase emulators:exec --only firestore --project demo-outof \"vitest run\"",
    "e2e": "node scripts/e2e.mjs",
    "icons": "pwa-assets-generator",
    "deploy": "npm run build && firebase deploy --only hosting,firestore"
  },
  "dependencies": {
    "firebase": "^13.0.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^6.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vite-pwa/assets-generator": "^2.0.0",
    "@vitejs/plugin-react": "^6.1.2",
    "firebase-tools": "^15.33.0",
    "playwright": "^1.64.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.0.3"
  }
}
