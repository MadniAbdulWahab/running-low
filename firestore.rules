rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function me() {
      return request.auth.uid;
    }

    function isMember(hid) {
      return signedIn()
        && me() in get(/databases/$(database)/documents/households/$(hid)).data.members;
    }

    function validName(n) {
      return n is string && n.size() > 0 && n.size() <= 60;
    }

    // Changes to memberNames may only touch the caller's own entry.
    function onlyMyMemberName() {
      return request.resource.data.memberNames.diff(resource.data.memberNames)
        .affectedKeys().hasOnly([me()])
        && validName(request.resource.data.memberNames[me()]);
    }

    match /users/{uid} {
      allow read, write: if signedIn() && me() == uid;
    }

    match /households/{hid} {
      allow get: if signedIn() && me() in resource.data.members;
      allow list: if false;
      allow delete: if false;

      allow create: if signedIn()
        && hid.matches('^[A-HJ-NP-Z2-9]{8}$')
        && request.resource.data.keys().hasOnly(['name', 'members', 'memberNames', 'createdAt'])
        && request.resource.data.members == [me()]
        && request.resource.data.memberNames.keys().hasOnly([me()])
        && validName(request.resource.data.memberNames[me()])
        && validName(request.resource.data.name);

      allow update: if signedIn() && (
        // A member edits the household name or their own display name.
        (me() in resource.data.members
          && request.resource.data.members == resource.data.members
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'memberNames'])
          && validName(request.resource.data.name)
          && onlyMyMemberName())
        ||
        // A member leaves: removes only themselves (and their name), nothing else.
        (me() in resource.data.members
          && request.resource.data.members == resource.data.members.removeAll([me()])
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members', 'memberNames'])
          && request.resource.data.memberNames.diff(resource.data.memberNames).affectedKeys().hasOnly([me()])
          && !(me() in request.resource.data.memberNames))
        ||
        // A non-member joins with the code, only while there is room.
        (!(me() in resource.data.members)
          && resource.data.members.size() < 2
          && request.resource.data.members == resource.data.members.concat([me()])
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members', 'memberNames'])
          && onlyMyMemberName())
      );

      function validItem() {
        let d = request.resource.data;
        return d.name is string && d.name.size() > 0 && d.name.size() <= 100
          && d.key is string && d.key.size() > 0 && d.key.size() <= 100
          && d.list in ['grocery', 'household', 'important']
          && d.status in ['needed', 'done']
          && (!('note' in d) || (d.note is string && d.note.size() <= 500))
          && (!('qty' in d) || (d.qty is int && d.qty >= 1 && d.qty <= 99));
      }

      match /items/{itemId} {
        allow read, delete: if isMember(hid);
        allow create, update: if isMember(hid) && validItem();
      }

      function validNote() {
        let d = request.resource.data;
        return d.text is string && d.text.size() <= 5000
          && d.color in ['peach', 'mint', 'sky', 'lilac', 'lemon', 'rose']
          && d.pinned is bool
          && d.checklist is list && d.checklist.size() <= 30
          && d.createdBy is string && d.updatedBy == me();
      }

      match /notes/{noteId} {
        allow read, delete: if isMember(hid);
        allow create: if isMember(hid) && validNote() && request.resource.data.createdBy == me();
        allow update: if isMember(hid) && validNote()
          && request.resource.data.createdBy == resource.data.createdBy;
      }

      // Hearts, hugs…: anyone on the list can send (as themselves) and tidy up; never edited.
      match /pings/{pingId} {
        allow read, delete: if isMember(hid);
        allow create: if isMember(hid)
          && request.resource.data.from == me()
          && request.resource.data.kind in ['heart', 'hug', 'kiss', 'miss', 'rose', 'think',
                                         'coffee', 'food', 'home', 'sleep', 'cheer', 'laugh']
          && request.resource.data.keys().hasOnly(['from', 'kind', 'createdAt']);
        allow update: if false;
      }

      // Push subscriptions: one per person, written only by its owner,
      // readable by the list's members (the sender's Worker reads them as the sender).
      match /push/{uid} {
        allow read: if isMember(hid);
        allow delete: if isMember(hid) && uid == me();
        allow create, update: if isMember(hid) && uid == me()
          && request.resource.data.subscription is string
          && request.resource.data.subscription.size() <= 2000
          && request.resource.data.prefs is map;
      }

      // Hearts counted per day: { [uid]: { heart: 18, … } }. Each person only bumps their own counts.
      match /pingDays/{day} {
        allow read: if isMember(hid);
        allow delete: if false;
        allow create: if isMember(hid)
          && day.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
          && request.resource.data.keys().hasOnly([me()])
          && request.resource.data[me()] is map;
        allow update: if isMember(hid)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([me()])
          && request.resource.data[me()] is map;
      }

      // Profile photos: each person writes only their own; everyone on the list sees them.
      match /profiles/{uid} {
        allow read: if isMember(hid);
        allow delete: if isMember(hid) && uid == me();
        allow create, update: if isMember(hid) && uid == me()
          && request.resource.data.keys().hasOnly(['photo', 'updatedAt'])
          && request.resource.data.photo is string
          && request.resource.data.photo.matches('^data:image/(jpeg|png|webp);base64,.*')
          && request.resource.data.photo.size() < 200000;
      }

      match /countdowns/{id} {
        allow read, delete: if isMember(hid);
        allow create, update: if isMember(hid)
          && request.resource.data.title is string
          && request.resource.data.title.size() > 0 && request.resource.data.title.size() <= 60
          && request.resource.data.date is string
          && request.resource.data.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
          && request.resource.data.emoji is string && request.resource.data.emoji.size() <= 8
          && request.resource.data.yearly is bool;
      }

      // Date jar ideas.
      match /ideas/{id} {
        allow read, delete: if isMember(hid);
        allow create, update: if isMember(hid)
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0 && request.resource.data.text.size() <= 200;
      }

      // "Our meals": saved meals with their ingredients, used to fill in planned days.
      match /recipes/{id} {
        allow read, delete: if isMember(hid);
        allow create, update: if isMember(hid)
          && request.resource.data.name is string
          && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 80
          && request.resource.data.ingredients is list && request.resource.data.ingredients.size() <= 20
          && (!('uses' in request.resource.data) || request.resource.data.uses is int);
      }

      // One planned meal per day; the doc id is the date.
      match /meals/{day} {
        allow read, delete: if isMember(hid);
        allow create, update: if isMember(hid)
          && day.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
          && request.resource.data.day == day
          && request.resource.data.name is string && request.resource.data.name.size() <= 80
          && request.resource.data.ingredients is list && request.resource.data.ingredients.size() <= 20
          && request.resource.data.updatedBy == me();
      }

      match /photos/{photoId} {
        allow read, delete: if isMember(hid);
        allow create, update: if isMember(hid)
          && request.resource.data.dataUrl is string
          && request.resource.data.dataUrl.matches('^data:image/.*')
          && request.resource.data.dataUrl.size() < 900000;
      }
    }
  }
}
